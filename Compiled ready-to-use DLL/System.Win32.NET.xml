        <member name="T:System32.BitOperations.Bit">
            <summary>
             Provides set of static methods for manipulating the
             bits of a number.
             NOTE: This type is Cross-Platform.
            </summary>
        </member>
        <member name="M:System32.BitOperations.Bit.ChangeBitAt(System.Int64,System.Int32,System32.BitOperations.BitState)">
            <summary>
             Changes the specified bit.
            </summary>
            <param name="number">The number</param>
            <param name="bitPosition">The position of the bit.</param>
            <param name="bitState">The state of the bit.</param>
            <returns>The new number.</returns>
        </member>
        <member name="M:System32.BitOperations.Bit.InvertAllBits(System.Int64)">
            <summary>
             Inverts all the bits of the number.
            </summary>
            <param name="number">
             The number witch bits to invert.
            </param>
            <returns>
             The new number.
            </returns>
        </member>
        <member name="M:System32.BitOperations.Bit.SetAllBits(System.Int64,System32.BitOperations.BitState)">
            <summary>
             Sets all bits to the specified number with the specifed value.
            </summary>
            <param name="number">
             The number.
            </param>
            <param name="bitState">
             The state of the bits.
            </param>
            <returns>
             The new number.
            </returns>
        </member>
